# Параметры сборки APK со встроенными моделями (передаются в Gradle как -P...). Скопируйте в .env и подставьте свои пути.
# Модели не входят в Git: скачайте их по config/models.json и положите под именами из таблицы в src/README.md.
GUZLIKVOICE_BUNDLE_DIR=/путь/к/bundles/light
GUZLIKVOICE_LLM_MODELS=vm-qwen06-ft
GUZLIKVOICE_AUTH_REQUIRED=false
# HEAVY: GUZLIKVOICE_BUNDLE_DIR=/путь/к/bundles/heavy и GUZLIKVOICE_LLM_MODELS=gemma2-2b-v90k
ANDROID_HOME=/путь/к/Android/sdk
