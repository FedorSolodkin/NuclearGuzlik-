<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingHorizontal="40dp"
    android:paddingVertical="60dp"
    android:background="@color/background">

    <!-- Kicker (roman numeral: I / III) — задаёт редакционный, «журнальный» тон
         вместо детского эмодзи. Прячем в самом верху, слегка приглушённо. -->
    <TextView
        android:id="@+id/tvOnboardingKicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textAllCaps="true"
        android:letterSpacing="0.3"
        android:textColor="@color/textMuted"
        android:layout_marginBottom="48dp"/>

    <!-- Тонкий монохромный иконный маркер вместо эмодзи — читается как smart-signal,
         а не как заголовок из детской книжки. -->
    <ImageView
        android:id="@+id/ivOnboardingIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginBottom="28dp"
        app:tint="@color/primary"
        android:contentDescription="@null"/>

    <TextView
        android:id="@+id/tvOnboardingTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="40sp"
        android:fontFamily="@font/instrument_serif"
        android:textColor="@color/textPrimary"
        android:gravity="center"
        android:layout_marginBottom="20dp"/>

    <TextView
        android:id="@+id/tvOnboardingDesc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textColor="@color/textSecondary"
        android:gravity="center"
        android:lineSpacingMultiplier="1.5"/>

</LinearLayout>
