<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="8dp"
    android:paddingVertical="10dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <!-- Цветной круглый аватар. Фон и цвет буквы задаются программно из SpeakerColors. -->
    <TextView
        android:id="@+id/tvSpeakerAvatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:gravity="center"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginEnd="12dp"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSpeakerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/TextAppearance.GuzlikVoice.Body.Large"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvSpeakerSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/TextAppearance.GuzlikVoice.Body.Small"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <!-- Preview: играет 2-3 сек фрагмент этого голоса из исходного аудио. -->
    <ImageButton
        android:id="@+id/btnSpeakerPreview"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="4dp"
        android:src="@drawable/ic_play"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Прослушать голос"
        android:visibility="gone"
        app:tint="@color/primary"/>

    <TextView
        android:id="@+id/tvSpeakerAction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Именовать"
        android:textSize="12sp"
        android:textColor="@color/primary"
        android:paddingHorizontal="8dp"/>
</LinearLayout>
