<?xml version="1.0" encoding="utf-8"?>
<!--
    Активное состояние (recording): переход от нежно-розового к кроваво-малиновому.
    Более "живой" контраст сигналит пользователю что запись идёт.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="radial"
        android:centerX="0.35"
        android:centerY="0.30"
        android:gradientRadius="130dp"
        android:startColor="#FFB0C0"
        android:centerColor="#E85773"
        android:endColor="#8B1834"/>
</shape>
