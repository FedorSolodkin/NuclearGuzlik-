<?xml version="1.0" encoding="utf-8"?>
<!--
    Премиальный радиальный градиент: светлое золото → тёплое золото → тёмная бронза.
    Три остановки создают "глубину" — иллюзию выпуклости, объёма без теней.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="radial"
        android:centerX="0.35"
        android:centerY="0.30"
        android:gradientRadius="130dp"
        android:startColor="#FFE28C"
        android:centerColor="#F0BF3D"
        android:endColor="#8A5A0F"/>
</shape>
